NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set production for the primary project. Test processes must set test plus RB_TEST_PROJECT_REF.
RB_EXPECT_DATABASE=production
RB_TEST_PROJECT_REF=
AI_SERVICE_URL=http://127.0.0.1:8000
# Optional shared local-only inference token. Set the same value in the AI environment.
AI_INTERNAL_TOKEN=
# Remote deployment: set HTTPS AI_SERVICE_URL, the exact custom tunnel hostname,
# and Cloudflare Access service-token credentials. Keep all values server-only.
AI_TUNNEL_HOST=
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=

# Server-only verified scan persistence. Never use NEXT_PUBLIC_ for these.
SUPABASE_SECRET_KEY=
SCAN_RECEIPT_SECRET=
