{
  "$jsonSchema": {
    "bsonType": "object",
    "required": [
      "ownerId",
      "mode",
      "detections",
      "createdAt"
    ],
    "properties": {
      "ownerId": {
        "bsonType": "string"
      },
      "mode": {
        "enum": [
          "photo",
          "live_snapshot"
        ]
      },
      "detections": {
        "bsonType": "array",
        "maxItems": 100,
        "items": {
          "bsonType": "object",
          "required": [
            "detectionId",
            "decision",
            "box"
          ]
        }
      },
      "createdAt": {
        "bsonType": "date"
      }
    }
  }
}
