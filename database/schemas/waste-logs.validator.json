{
  "$jsonSchema": {
    "bsonType": "object",
    "required": [
      "ownerId",
      "clientEventId",
      "itemId",
      "quantity",
      "confirmed",
      "disposedAt"
    ],
    "properties": {
      "ownerId": {
        "bsonType": "string"
      },
      "clientEventId": {
        "bsonType": "string"
      },
      "itemId": {
        "bsonType": "string"
      },
      "quantity": {
        "bsonType": "int",
        "minimum": 1,
        "maximum": 100
      },
      "confirmed": {
        "enum": [
          true
        ]
      },
      "disposedAt": {
        "bsonType": "date"
      }
    }
  }
}
